# URL base del backend (Spring Boot en Railway) — proxy OAuth + API REST
VITE_BACKEND_URL=https://oncall-production-9337.up.railway.app

# En desarrollo local, usa proxy de Vite para evitar CORS hacia backend remoto.
# true (default): frontend llama a /api y /oauth2 en localhost, Vite reenvia.
# false: frontend llama directo a VITE_BACKEND_URL.
VITE_USE_DEV_PROXY=true

# JWT opcional para desarrollo local (evita flujo OAuth si backend productivo
# redirige a dominio de produccion). Si existe y no hay token en localStorage,
# se guarda automaticamente como "oncall_jwt".
VITE_DEV_JWT=
